# Copy to /etc/lwstudio/lws.env and keep it readable only by root/lwstudio.
LWS_DEPLOYMENT_MODE=cloud
LWS_AUTH_MODE=required
LWS_DATA_ROOT=/srv/lwstudio/data
LWS_GIT_SHA=replace-with-release-git-sha
LWS_MAX_UPLOAD_MB=1024
# Bootstrap only: remove LWS_ADMIN_PASSWORD after the first admin changes it.
LWS_ADMIN_USER=admin
LWS_ADMIN_PASSWORD=replace-with-strong-bootstrap-password
